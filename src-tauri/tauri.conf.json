{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scope",
  "version": "0.1.91",
  "identifier": "com.khurram.scope",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Scope",
        "width": 1100,
        "height": 700,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' scope-icon: data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFFMzAwNkYwN0NENzc3QzYKUldUR2Q5ZDg4QVl3SGhRQlJWa1NrUTJ4VGJuY0tiNFU4dVlaQzhxdHNpdkhxb2s2LytIYVE3Y0oK",
      "endpoints": [
        "https://github.com/khurrambhutto/scope/releases/latest/download/latest.json"
      ]
    }
  }
}
